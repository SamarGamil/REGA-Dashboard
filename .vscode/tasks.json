{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Restore API",
			"type": "process",
			"command": "dotnet",
			"args": [
				"restore",
				"Backend\\AqarInsights.Api\\AqarInsights.Api.csproj",
				"--source",
				"https://api.nuget.org/v3/index.json"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "Build API",
			"type": "process",
			"command": "dotnet",
			"args": [
				"build",
				"Backend\\AqarInsights.Api\\AqarInsights.Api.csproj",
				"--no-restore"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": "$msCompile",
			"dependsOn": [
				"Restore API"
			],
			"dependsOrder": "sequence"
		},
		{
			"label": "Build Angular",
			"type": "process",
			"command": "npm",
			"args": [
				"run",
				"build"
			],
			"options": {
				"cwd": "${workspaceFolder}\\Front"
			},
			"problemMatcher": []
		},
		{
			"label": "Build API and Angular",
			"dependsOn": [
				"Build API",
				"Build Angular"
			],
			"dependsOrder": "parallel",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "Run API",
			"type": "process",
			"command": "dotnet",
			"args": [
				"run",
				"--no-restore",
				"--project",
				"Backend\\AqarInsights.Api\\AqarInsights.Api.csproj",
				"--launch-profile",
				"http"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"dependsOn": [
				"Restore API"
			],
			"dependsOrder": "sequence",
			"isBackground": true,
			"problemMatcher": {
				"base": "$msCompile",
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Now listening on: http://localhost:5032"
				}
			}
		},
		{
			"label": "Run Angular",
			"type": "process",
			"command": "npm",
			"args": [
				"start"
			],
			"options": {
				"cwd": "${workspaceFolder}\\Front"
			},
			"isBackground": true,
			"problemMatcher": {
				"pattern": {
					"regexp": "^(.*)$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".",
					"endsPattern": "Application bundle generation complete\\."
				}
			}
		},
		{
			"label": "Run API and Angular",
			"dependsOn": [
				"Run API",
				"Run Angular"
			],
			"dependsOrder": "parallel",
			"problemMatcher": []
		}
	]
}
