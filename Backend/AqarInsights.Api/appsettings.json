{
  "Serilog": {
    "Using": [ "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithEnvironmentName" ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": ["https://10.240.112.21:9061"]
  },
  "Assistant": {
    "BaseUrl": "https://llms.elm.sa/v1",
    "Model": "Qwen3.6",
    "ApiKey": "",
    "Temperature": 0.2,
    "MaxTokens": 900,
    "DisableThinking": true
  },
  "DataSettings": {
    "InputDir": "Data",
    "OutputDir": "Data",
    "TransactionsFile": "Data/transactions.json",
    "FilterOptionsFile": "Data/filter-options-updated.json"
  },
  "RentalControlsDataSettings": {
    "SourceDir": "Data/rental-controls-source",
    "OutputDir": "Data/rental-controls"
