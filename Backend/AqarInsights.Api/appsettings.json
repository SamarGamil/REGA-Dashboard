  "Logging": {
    "File": {
      "Directory": "C:\\OIS\\Dashboard\\Backend\\Logs"
    }
  },
  "AuthSettings": {
    "JwtSecret": "AqarInsights-Dev-Secret-Key-Min-32-Characters-Long!",
    "JwtExpiryHours": 24
  }
