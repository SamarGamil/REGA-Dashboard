      "salesTransactionCount": { "Value": 3, "Label": "حد الصفقات 3 آلاف" },
      "avgSalesTransactionValue": { "Value": 800000, "Label": "متوسط القيمة 800 ألف" },
      "actualRentCpi": { "Value": 110, "Label": "حد CPI 110" },
      "generalInflationCpi": { "Value": 3, "Label": "حد التضخم 3%" },
      "apartmentRentIndex": { "Value": 115, "Label": "حد الشقة 115" },
      "floorRentIndex": { "Value": 112, "Label": "حد الدور 112" },
      "villaRentIndex": { "Value": 118, "Label": "حد الفيلا 118" }
